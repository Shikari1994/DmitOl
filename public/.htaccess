# Статический сайт Astro на Apache-хостинге (reg.ru).
# Файл копируется в dist/ при сборке и должен лежать в корне домена.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Единственный канонический адрес: https без www.
  #
  # На reg.ru TLS завершается на фронтенде (nginx/DDoS-Guard), а до Apache
  # запрос доходит уже по http — поэтому %{HTTPS} здесь всегда «off» и одной
  # этой проверки мало: она даёт бесконечный цикл редиректов
  # (ERR_TOO_MANY_REDIRECTS, поймали 2026-07-30). Настоящий протокол клиента
  # приезжает в заголовке X-Forwarded-Proto — редиректим, только если обе
  # проверки говорят, что соединение не защищено.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Здесь цикла быть не может: после редиректа хост уже без www.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# Astro собирает страницы как /path/index.html.
DirectoryIndex index.html
Options -Indexes

# Автодеплой (GitHub Actions) кладёт в корень служебный слепок залитых файлов —
# наружу его отдавать незачем.
<Files ".ftp-deploy-sync-state.json">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Ассеты Astro содержат хэш в имени — кэшируем надолго.
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  # HTML всегда перепроверяем, иначе после деплоя отдаётся старая разметка.
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

AddType font/woff2 .woff2
AddType video/mp4 .mp4
