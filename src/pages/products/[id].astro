---
import Layout from '../../layouts/Layout.astro'
import Nav from '../../components/Nav.astro'
import Footer from '../../components/Footer.astro'
import BulletList from '../../components/BulletList.astro'
import { asset } from '../../lib/asset.js'
import { PRODUCTS } from '../../data/products.js'

export function getStaticPaths() {
  return PRODUCTS.map((p) => ({ params: { id: p.id }, props: { product: p } }))
}

const { product } = Astro.props
---

<Layout
  title={`${product.title} — ${product.line} · ГЕОТЕХНАВИГАЦИЯ`}
  description={product.text}
>
  <div class="bg-fx"></div>
  <Nav />
  <main id="main">
    <section id="product" data-theme="black" class="product-page">
      <div class="container">
        <a class="product-back" href={asset('/#products')}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
          Продукция
        </a>

        <div class="product-header">
          <h1 class="h-title product-title reveal">{product.title}</h1>
          <p class="product-line mono reveal">{product.line}</p>
        </div>

        <div class="product-layout">
          <div class="product-main">
            {(product.pageImage || product.image) && (
              <div class={`product-photo product-photo--${product.id} reveal${product.pageImage && !product.photoFull ? ' is-crop' : ''}${product.photoFull ? '' : ' is-compact'}`}>
                {product.pageImage ? (
                  <img src={asset(product.pageImage)} alt={product.title} loading="eager" />
                ) : (
                  <>
                    <img src={asset(product.image)} alt={product.title} loading="eager"
                      class={product.imageLight ? 'theme-img theme-img--dark' : undefined} />
                    {product.imageLight && (
                      <img src={asset(product.imageLight)} alt={product.title} loading="eager" class="theme-img theme-img--light" />
                    )}
                  </>
                )}
              </div>
            )}

            {(product.pageText ?? [product.text]).map((paragraph) => (
              <p class="product-text reveal">{paragraph}</p>
            ))}

            {product.highlights?.length > 0 && (
              <>
                <h2 class="product-specs-title reveal">{product.highlightsTitle}</h2>
                <div class="reveal"><BulletList items={product.highlights} /></div>
              </>
            )}

            {product.modules?.length > 0 && (
              <>
                <h2 class="product-specs-title reveal">{product.modulesTitle}</h2>
                <ul class="product-modules reveal">
                  {product.modules.map(([num, title, desc]) => (
                    <li class="product-module">
                      <span class="product-module-num mono">{num}</span>
                      <div>
                        <h3 class="product-module-title">{title}</h3>
                        {Array.isArray(desc) ? (
                          <BulletList items={desc} />
                        ) : (
                          <p class="product-module-text">{desc}</p>
                        )}
                      </div>
                    </li>
                  ))}
                </ul>
              </>
            )}

            {product.tables?.length > 0 && product.tables.map((table) => (
              <div class="product-table-block reveal">
                <h2 class="product-specs-title">{table.title}</h2>
                <div class="product-table-wrap">
                  <table class="product-table">
                    <thead>
                      <tr>
                        {table.columns.map((col) => <th scope="col">{col}</th>)}
                      </tr>
                    </thead>
                    <tbody>
                      {table.rows.map((row) => (
                        <tr>
                          {row.map((cell, i) => {
                            const content = Array.isArray(cell)
                              ? cell.map((line, li) => <>{li > 0 && <br />}{line}</>)
                              : cell
                            return i === 0 ? <th scope="row">{content}</th> : <td>{content}</td>
                          })}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            ))}

            {product.extraBlocks?.length > 0 && product.extraBlocks.map((block) => (
              <>
                <h2 class="product-specs-title reveal">{block.title}</h2>
                <div class="reveal"><BulletList items={block.items} /></div>
              </>
            ))}

            {product.specs.length > 0 && (
              <>
                <h2 class="product-specs-title reveal">{product.specTitle}</h2>
                <dl class="product-specs reveal">
                  {product.specs.map(([label, value]) => (
                    <div class="product-spec-row">
                      <dt>{label}</dt>
                      <dd>{value}</dd>
                    </div>
                  ))}
                </dl>
              </>
            )}

            {product.specs2?.length > 0 && (
              <>
                <h2 class="product-specs-title reveal">{product.specTitle2}</h2>
                <dl class="product-specs reveal">
                  {product.specs2.map(([label, value]) => (
                    <div class="product-spec-row">
                      <dt>{label}</dt>
                      <dd>{value}</dd>
                    </div>
                  ))}
                </dl>
              </>
            )}
          </div>

          <aside class="product-menu reveal" aria-label="Вся продукция">
            <span class="product-menu-title mono">Вся продукция</span>
            <ul>
              {PRODUCTS.map((p) => (
                <li>
                  <a
                    class={`product-menu-link${p.id === product.id ? ' is-active' : ''}`}
                    href={asset(`/products/${p.id}`)}
                    aria-current={p.id === product.id ? 'page' : undefined}
                  >
                    <span class="product-menu-num mono">{p.n}</span>
                    <span class="product-menu-label">{p.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
