---
import Layout from '../../layouts/Layout.astro'
import Nav from '../../components/Nav.astro'
import Footer from '../../components/Footer.astro'
import { asset } from '../../lib/asset.js'
import { PRODUCTS } from '../../data/products.js'

export function getStaticPaths() {
  return PRODUCTS.map((p) => ({ params: { id: p.id }, props: { product: p } }))
}

const { product } = Astro.props
---

<Layout
  title={`${product.title} — ${product.line} · ГЕОТЕХНАВИГАЦИЯ`}
  description={product.text}
>
  <div class="bg-fx"></div>
  <Nav />
  <main id="main">
    <section id="product" data-theme="black" class="product-page">
      <div class="container">
        <a class="product-back" href={asset('/#products')}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
          Продукция
        </a>

        <div class="product-header">
          <h1 class="h-title product-title reveal">{product.title}</h1>
          <p class="product-line mono reveal">{product.line}</p>
        </div>

        <div class="product-layout">
          <div class="product-main">
            {product.image && (
              <div class="product-photo reveal">
                <img src={asset(product.image)} alt={product.title} loading="eager" />
              </div>
            )}

            <p class="product-text reveal">{product.text}</p>

            {product.specs.length > 0 && (
              <>
                <h2 class="product-specs-title reveal">{product.specTitle}</h2>
                <dl class="product-specs reveal">
                  {product.specs.map(([label, value]) => (
                    <div class="product-spec-row">
                      <dt>{label}</dt>
                      <dd>{value}</dd>
                    </div>
                  ))}
                </dl>
              </>
            )}
          </div>

          <aside class="product-menu reveal" aria-label="Вся продукция">
            <span class="product-menu-title mono">Вся продукция</span>
            <ul>
              {PRODUCTS.map((p) => (
                <li>
                  <a
                    class={`product-menu-link${p.id === product.id ? ' is-active' : ''}`}
                    href={asset(`/products/${p.id}`)}
                    aria-current={p.id === product.id ? 'page' : undefined}
                  >
                    <span class="product-menu-num mono">{p.n}</span>
                    <span class="product-menu-label">{p.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
