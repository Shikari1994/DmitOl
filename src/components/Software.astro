---
import { asset } from '../lib/asset.js'

/* Плитки только настольной версии: мобильный клиент вынесен в отдельную
   секцию (Mobile.astro) и показан там во всю ширину. Плиткой он оставался
   бы одним скриншотом среди пяти, а это отдельный продукт. */
/* Один кадр на всю ширину секции, вкладки переключают модуль — вместо
   мозаики из пяти плиток, где читаемым оставался только герой-кадр,
   а КНБК (2.70:1) в узкой колонке превращался в нечитаемую полоску.
   Вкладки вторят родной верхней навигации Drill Monitor (см. сам
   скриншот app-drilling.webp: «Бурение · Инклинометрия · … »).
   Внутри кадра скриншот и подпись — не стопкой (шапка на весь экран
   душит текст под собой), а колонками по швейцарскому канону сайта:
   тот же принцип asymmetric-сплита, что у .split (~66/34), реализован
   прямо в CSS на .sw-slide.is-active, без переиспользования класса —
   .split завязан на --rail-* шапки, а этот сплит живёт внутри рамки.
   Пропорция кадра (ширина/высота) зашита в CSS (.bt-<key> .bento-shot) —
   держать в паре со сменой видео.
   Все пять вкладок — видео (одного кадра, ~2.08:1 у источника), без
   отдельного постера-скриншота: первый кадр держит сам ролик (см.
   data-hold-frame в scripts/motion/lazyVideo.js), а не img поверх него —
   иначе кадр постера не совпадал с реальным первым кадром видео и при
   старте воспроизведения было видно подмену.
   drilling 2.098:1 (1.mp4) · survey 2.083:1 (2.mp4) ·
   logging 2.071:1 (3.mp4) · bha 2.089:1 (4.mp4) ·
   park 2.089:1 (5.mp4) */
const MODULES = [
  {
    key: 'drilling',
    n: '01',
    tab: 'Бурение',
    // единственный настоящий real-time монитор — только он носит бейдж LIVE
    live: true,
    video: '/video/1.mp4',
    title: 'Мониторинг бурения в реальном времени',
    text: 'Единый пульт бурильщика: проходка, нагрузка на долото, момент, обороты, давление, гамма-каротаж и сопротивление — десятки каналов телеметрии с обновлением в реальном времени. Цветовая индикация порогов (норма / внимание / авария) подсвечивает отклонение раньше, чем оно станет аварией — не цифры в таблице, а светофор. Отдельно — ориентация инструмента (toolface) и счётчик часов циркуляции, автоматическая SCC-коррекция азимута от магнитных помех стальной компоновки.',
    tags: ['Real-time', 'Телеметрия MWD', 'Коррекция азимута'],
  },
  {
    key: 'survey',
    n: '02',
    tab: 'Инклинометрия',
    video: '/video/2.mp4',
    title: 'Инклинометрия и 3D-траектория',
    text: 'Инженер вводит замеры глубины, угла и азимута — система по методу минимальной кривизны сама считает истинную вертикальную глубину (TVD) и интенсивность искривления (dogleg) и сравнивает факт с проектной траекторией в 3D. Видно, уходит ли скважина от плана, до того как отклонение станет проблемой.',
    tags: ['3D-ствол', 'План / факт', 'Метод минимальной кривизны'],
  },
  {
    key: 'logging',
    n: '03',
    tab: 'Каротаж',
    video: '/video/3.mp4',
    title: 'Каротажный планшет LWD',
    text: 'Построение каротажного планшета по глубине — гамма-каротаж и сопротивление — с экспортом в PDF и отраслевой формат LAS. Тот же планшет, что печатают на буровой, но без бумаги и ручного черчения.',
    tags: ['Гамма-каротаж', 'Экспорт LAS / PDF'],
  },
  {
    key: 'bha',
    n: '04',
    tab: 'Оборудование',
    video: '/video/4.mp4',
    title: 'Компоновка КНБК и ресурс',
    text: 'Не только этот рейс — весь парк техники. Компоновка собирается перетаскиванием элементов, а инженерные расчёты — прочность резьбовых соединений по методике API RP 7G, поправка на прогиб инструмента (sag) — считаются прямо в приложении, вместо отдельных таблиц «на коленке».',
    tags: ['КНБК / BHA', 'Ресурс до ТО', 'Расчёт BSR (API RP 7G)'],
  },
  {
    key: 'park',
    n: '05',
    tab: 'Паспорта',
    video: '/video/5.mp4',
    title: 'Паспорт и наработка прибора',
    text: 'Живёт с прибором, а не со скважиной. Статус, серийный номер и наработка с прогресс-баром до ближайшего ТО — по каждому модулю телеметрии и элементу КНБК, с поиском по серийному номеру и выгрузкой официального паспорта в Excel с реальной наработкой по рейсам.',
    tags: ['Наработка', 'История рейсов', 'ЗИП'],
  },
]

/* Второй пласт раздела: то, что не видно на скриншотах, но чем система
   занята между рейсами. Кадр с вкладками показывает мониторинг — эти три
   пункта показывают учёт, и вместе они и есть полный цикл: прибор заведён
   в базу, наработка набежала сама, паспорт выгрузился готовым.

   Отдельным блоком, а не плитками: у него нет кадра, который стоило бы
   показать, а текст на 40 слов мелкая плитка не держит. */
/* Видео-плашка «мобильной экосистемы» из D:\Projects\Dmit (секция
   «МОБИЛЬНАЯ ЭКОСИСТЕМА») — переносим ролик и три плитки с текстом
   дословно, а не заголовок: у Dmit там «DRILL MONITOR // MOBILE
   ECOSYSTEM» + «Контроль параметров в любой точке мира», но здесь
   этот заголовок уже занят собственной шапкой раздела (.sw-head выше). */
const ECOSYSTEM = [
  {
    n: '01', label: 'КРОСС ПЛАТФОРМА',
    text: 'Полноценная экосистема для мгновенного контроля: доступна через Web, Desktop-клиент и mobile приложение Android APK.',
  },
  {
    n: '02', label: 'УДАЛЕННЫЙ МОНИТОРИНГ',
    text: 'Система полностью ликвидирует информационный вакуум. Буровая площадка, офис компании и база сервиса находятся в едином инфо-поле.',
  },
  {
    n: '03', label: 'КАНАЛ WEBSOCKET',
    text: 'Обеспечивает непрерывный стриминг данных в реальном времени даже при крайне низком и нестабильном спутниковом сигнале.',
  },
]

const LIFECYCLE = [
  {
    n: '01',
    title: 'Общее хранилище оборудования',
    text: 'Каждый прибор, переводник и элемент КНБК заведён в базу один раз — с серийным номером, паспортными характеристиками и полной историей. Все подразделения работают с одним справочником, а не с десятком разрозненных таблиц: где сейчас прибор, в каком он рейсе и кто обслуживал его последним, видно из любого офиса.',
  },
  {
    n: '02',
    title: 'Наработка считается автоматически',
    text: 'Часы циркуляции и вращения, метры проходки, число рейсов, температурные режимы и износ резьбовых соединений API 7G пишутся на конкретный серийный номер прямо из данных рейса — без журналов и ручного переноса. Система заранее предупреждает о подходе к ресурсу, поэтому ТО планируется до отказа и до обрыва КНБК на резьбе, а не после.',
  },
  {
    n: '03',
    title: 'Паспорта заполняются сами',
    text: 'Паспорт прибора собирается из уже накопленных данных: наработка, история ремонтов и калибровок, результаты последних рейсов. Готовый документ выгружается в PDF за секунды — вместо часов переписывания цифр из журналов в шаблон и расхождений между копиями.',
  },
]
---

<section id="software" data-theme="black">
  <div class="container">
    <div class="eyebrow reveal"><span class="ey-no">03<span class="ey-den"> / 06</span></span>Программный комплекс · настольная версия</div>
    <div class="sw-head grid">
      <h2 class="h-title reveal">
        Drill&nbsp;Monitor — мониторинг <br />бурения в реальном времени
      </h2>
      <div class="sw-head-side reveal">
        <p class="lead">
          Единая платформа для геонавигации: телеметрия MWD/LWD, инклинометрия,
          каротаж — и полный учёт парка оборудования с наработкой и паспортами.
          Один интерфейс на буровой, в офисе и на мобильном.
        </p>
        <div class="sw-actions">
          <a class="btn btn-primary" href="https://oklimashov2.fvds.ru/" target="_blank" rel="noopener noreferrer">
            <span class="btn-corners" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
            Запустить демо приложения
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
          </a>
          <a class="btn btn-ghost" href="#contact">
            <span class="btn-corners" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
            Стать пользователем
          </a>
        </div>
      </div>
    </div>

    <div class="sw-eco reveal">
      <div class="sw-eco-media" aria-hidden="true">
        {/* Два ролика, один и тот же кадр в двух цветовых версиях: тёмный
            видим всегда, светлый (белые оттенки, от пользователя) — только
            при html[data-scheme="light"] (см. index.css). CSS выключает
            неактивный через display:none, поэтому лениво грузится (см.
            motion.js, video[data-lazy-video]) только тот ролик, что сейчас
            показан — второй начнёт качаться только после переключения темы. */}
        <video
          class="sw-eco-video sw-eco-video--dark"
          data-lazy-video={asset('/ecosystem.mp4')}
          muted
          loop
          playsinline
          preload="none"
        ></video>
        <video
          class="sw-eco-video sw-eco-video--light"
          data-lazy-video={asset('/white.mp4')}
          muted
          loop
          playsinline
          preload="none"
        ></video>
        <img class="sw-eco-logo" src={asset('/LOGODM.svg')} alt="Drill Monitor" />
      </div>
      <div class="sw-eco-tiles">
        {ECOSYSTEM.map((t) => (
          <div class="sw-eco-tile glass">
            <span class="sw-eco-tile-n mono">{t.n} // {t.label}</span>
            <p>{t.text}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="sw-stage reveal">
      <div class="sw-tabs" data-sw-tabs>
        {MODULES.map((m, i) => (
          <button
            type="button"
            class={'sw-tab' + (i === 0 ? ' is-active' : '')}
            data-sw-tab
            data-index={i}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >
            <span class="sw-tab-n mono">{m.n}</span>
            <span class="sw-tab-label">{m.tab}</span>
          </button>
        ))}
      </div>

      <div class="sw-frame instr-frame">
        {MODULES.map((m, i) => (
          <figure class={`sw-slide bt-${m.key}` + (i === 0 ? ' is-active' : '')} data-sw-slide data-index={i}>
            <div class="bento-body">
              <h3>{m.title}</h3>
              {m.text && <p>{m.text}</p>}
              <div class="tag-row">
                {m.tags.map((t) => <span class="tag">{t}</span>)}
              </div>
            </div>
            <div
              class="sw-slide-shot"
              data-video-lightbox-trigger
              role="button"
              tabindex="0"
              aria-label={`Открыть видео «${m.title}» на весь экран`}
            >
              <video
                class="bento-shot"
                data-lazy-video={asset(m.video)}
                data-hold-frame
                muted
                loop
                playsinline
                preload="none"
                aria-label={m.title}
              />
              <div class="bento-bar">
                <span class="bento-kicker mono"><span class="bento-n">{m.n}</span> · {m.tab}</span>
                {m.live && <span class="bento-live"><span class="bento-live-dot" />LIVE</span>}
              </div>
              <span class="sw-expand" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3H3v6M15 3h6v6M9 21H3v-6M15 21h6v-6" /></svg>
              </span>
            </div>
          </figure>
        ))}
      </div>
    </div>

    <div class="video-lightbox" data-video-lightbox aria-hidden="true">
      <div class="video-lightbox-backdrop" data-video-lightbox-close></div>
      <button type="button" class="video-lightbox-close" data-video-lightbox-close>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
        <span>Назад</span>
      </button>
      <div class="video-lightbox-stage" data-video-lightbox-stage>
        <video class="video-lightbox-video" data-video-lightbox-video muted loop playsinline autoplay></video>
      </div>
    </div>

    <div class="sw-life">
      <div class="sw-life-head reveal">
        <span class="sw-life-kicker mono">Между рейсами</span>
        <h3 class="sw-life-title">
          От учёта до паспорта — без единой таблицы вручную
        </h3>
      </div>
      <div class="sw-life-grid">
        {LIFECYCLE.map((f) => (
          <div class="sw-life-item reveal">
            <span class="sw-life-sheen" data-life-sheen aria-hidden="true"></span>
            <span class="sw-life-n mono">{f.n}</span>
            <h4>{f.title}</h4>
            <p>{f.text}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
