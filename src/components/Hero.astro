---
import { Image } from 'astro:assets'
import { asset } from '../lib/asset.js'
import heroPoster from '../assets/ui/hero-poster.webp'
import markWhite from '../assets/brand/mark-white.png'
import markBlack from '../assets/brand/mark-black.png'
import appDesktop from '../assets/ui/app-desktop.webp'
import appMobileDrilling from '../assets/ui/app-mobile-drilling.webp'
import mwdKitHero from '../assets/products/mwd-kit-hero.webp'

/* ── HERO · буквальный перенос из Dmit ──
   Не адаптация под токены сайта, а прямой перевод разметки и значений:
   свои цвета, Inter black на заголовке, контурная кнопка с инверсией на
   hover, лого-плашка «ГТН», тонкие 8%-границы, стеклянная подложка
   правой колонки. Всё — из style-блока и классов Dmit, не на глаз.

   Два сознательных отличия: сцены в плитках (ноутбук+телефон, снаряд —
   этого контента у Dmit нет, довыезжают по hover, чистый CSS) и реальные
   якоря вместо onclick scrollIntoView. */
---

<section id="hero" data-theme="black" class="hero-intro">
  <div class="hero-media" aria-hidden="true">
    <!-- Вес первого экрана: poster + preload="metadata". Постер (первый
         кадр ролика, ~40 КБ) рисуется сразу, сам файл догружается следом
         и подменяет его незаметно — кадр тот же. "metadata", а не "none":
         видео нужно здесь и сейчас, мы не откладываем загрузку, а лишь
         снимаем её с критического пути первой отрисовки.

         Ролик НЕ перекодирован, и это осознанно: материал полнокадровый,
         его 5387 кб/с тратятся по делу. CRF 32 даёт видимые блоки, CRF 22
         возвращает те же 6.6 МБ, денойз не меняет ничего — дело не в
         зерне. Сделаны только два приёма без потерь: снята звуковая
         дорожка (элемент всегда muted) и moov переставлен в начало
         (+faststart), иначе браузер ждёт полной загрузки. Видеопоток
         бит-в-бит прежний. Срезать вес можно только пересведением из
         исходного проекта, а не повторным сжатием уже сжатого. -->
    <video
      class="hero-media-video"
      data-hero-video
      src={asset('/video/hero-background.mp4')}
      poster={heroPoster.src}
      preload="metadata"
      loop
      muted
      playsinline
    ></video>
    <div class="hero-media-scrim"></div>
  </div>

  <div class="hero-readout mono" data-cursor-readout aria-hidden="true">
    <span>AZ <b data-cursor-az>000.0°</b></span>
    <span>INC <b data-cursor-inc>00.0°</b></span>
    <span class="hero-readout-note">Симуляция датчика</span>
  </div>

  <div class="hero-grid">
    <div class="hero-copy">
      <div class="hero-copy-top">
        <span class="hero-tag mono">Научно-производственный комплекс</span>
        <div class="hero-brand">
          <span class="hero-brand-mark">
            {/* height вдвое больше самой крупной вёрстки (108px на ≥1280px,
                см. .hero-brand-mark в hero.css) — запас под ретину и не
                больше: исходники PNG в разы крупнее, чем нужно на экране. */}
            <Image class="hero-brand-mark-img hero-brand-mark-img--dark" src={markWhite} height={216} format="webp" alt="ГТН" loading="eager" draggable="false" />
            <Image class="hero-brand-mark-img hero-brand-mark-img--light" src={markBlack} height={216} format="webp" alt="ГТН" loading="eager" draggable="false" />
          </span>
          <h1 class="hero-brand-title">ГЕОТЕХ<br />НАВИГАЦИЯ</h1>
        </div>
      </div>

      <div class="hero-copy-bottom">
        <p class="hero-lead">
          Разработка, серийное производство и сервис забойных телеметрических систем MWD/LWD и цифрового инженерного софта.
           Создаём замкнутую экосистему бурения: от высокоточного скважинного железа до платформ удалённого онлайн-контроля проходки.

        </p>
      </div>
    </div>

    <div class="hero-teasers">
      {/* Плитка 1 · инженерный софт. Сцена «ноутбук + телефон» — добавка
          сверх Dmit, видна сразу; по наведению телефон слегка отъезжает
          влево (см. .hero-tile-art в hero.css). */}
      <a class="hero-tile" href="#software">
        <span class="hero-tile-corners" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <div class="hero-tile-art" aria-hidden="true">
          <div class="hero-tile-stage">
            <div class="hero-tile-note">
              <Image src={appDesktop} alt="" loading="eager" draggable="false" />
            </div>
            <div class="hero-tile-phone">
              <div class="hero-tile-phone-move">
                <Image src={appMobileDrilling} alt="" loading="eager" draggable="false" />
              </div>
            </div>
          </div>
        </div>
        <div class="hero-tile-row">
          <span class="hero-tile-label mono">инженерный_софт</span>
          <span class="hero-tile-status mono is-live">●&nbsp;Интерактивный стенд</span>
        </div>
        <div class="hero-tile-foot">
          <span class="hero-tile-title mono">Drill Monitor</span>
          <p class="hero-tile-text">
            Кроссплатформенное программное обеспечение для мгновенной синхронизации
            и удалённого контроля процессов бурения.
          </p>
        </div>
      </a>

      {/* Плитка 2 · аппаратное производство. Та же логика выезда по
          наведению. Акцент текста здесь sky-400, а не logoBlue — так и у
          Dmit (.hero-tile--sky). Кадр свой: на странице товара 01 стоит
          другой, см. pageImage в data/products.js. */}
      <a class="hero-tile hero-tile--sky" href="#products">
        <span class="hero-tile-corners" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <div class="hero-tile-art hero-tile-art--rig" aria-hidden="true">
          <div class="hero-tile-rig">
            {/* Кадр рисуется высотой до 300px (.hero-tile-rig img), 600 —
                тот же двойной запас под ретину. */}
            <Image src={mwdKitHero} height={600} alt="" loading="eager" draggable="false" />
          </div>
        </div>
        <div class="hero-tile-row">
          <span class="hero-tile-label mono">аппаратное_производство</span>
          <span class="hero-tile-status mono">●&nbsp;К каталогу систем</span>
        </div>
        <div class="hero-tile-foot">
          <span class="hero-tile-title mono">GT-Navigator</span>
          <p class="hero-tile-text">
            Серийное производство телесистем с гидравлическим каналом связи, прецизионными инклинометрическими модулями и блоками декодирования.
          </p>
        </div>
      </a>
    </div>
  </div>
</section>
