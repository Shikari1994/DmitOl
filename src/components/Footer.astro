---
import { asset } from '../lib/asset.js'
---

<footer id="contact">
  <div class="footer-row">
    <section class="footer-cell footer-cell-contacts" aria-label="Телефон и почта">
      <span class="footer-tag mono">наши_контакты</span>
      <div class="footer-contact-list">
      <a href="tel:+79031098895">+7 (903) 109-88-95</a>
      <a href="mailto:info@geo-tn.com">info@geo-tn.com</a>
      </div>
    </section>
    <div class="footer-cell footer-cell-address">
      <span class="footer-tag mono">адрес_офиса</span>
      <address class="footer-address-text">123007, г. Москва, 5-я Магистральная, д. 10а, офис 15</address>
      <a
        class="footer-document"
        href={asset('/documents/drill-monitor-registration-certificate.pdf')}
        target="_blank"
        rel="noopener noreferrer"
        type="application/pdf"
        aria-label="Открыть цветное свидетельство о регистрации Drill Monitor (PDF, новая вкладка)"
      >
        <img
          src={asset('/documents/drill-monitor-registration-preview.png')}
          alt=""
          width="311"
          height="440"
          loading="eager"
          decoding="async"
        />
        <span class="footer-document-open mono" aria-hidden="true">PDF ↗</span>
      </a>
    </div>
  </div>
</footer>
