---
/* «Экономика бурения» — 2026-07-21, секция переписана 1-в-1 по
   D:\Projects\Dmit (второй блок под секцией продукции, «БЕЗОПАСНОСТЬ
   И КРИТИЧЕСКАЯ АНАЛИТИКА»): пользователь явно попросил буквальный
   перенос текста и оформления, тем же приёмом и по тем же причинам,
   что и Showcase.astro (см. память dmit-sibling-reference) — включая
   реопен grid-border-эстетики для этой конкретной секции. Нумерованный
   eyebrow «0X / 09» общей нав-схемы сайта здесь снят по тому же
   прецеденту, что и в Showcase: место кикера занимает буквальный
   кикер Dmit.

   Тексты — дословный перенос, не парафраз, вплоть до опечатки в
   исходнике Dmit («Problem 02» вместо «Проблема 02» — там же
   вперемешку транслит и русский, сохранено намеренно). */
const PROBLEMS = [
  {
    kicker: 'Проблема 01 // фрагментация',
    title: 'Разрозненность систем',
    text: 'Когда инклинометрия, расчет прочности колонны и учет износа приборов ведутся в разных программах, общая картина теряется, увеличивая время принятия решений.',
  },
  {
    kicker: 'Problem 02 // ручной ввод',
    title: 'Учет наработки «на глаз»',
    text: 'Постоянный ручной перенос данных в журналы и Excel маскирует фактический износ внутренних узлов телесистем, приводя к внезапным отказам электроники и дорогостоящему НПВ.',
  },
  {
    kicker: 'Проблема 03 // инфо-вакуум',
    title: 'Ошибки интерпретации',
    text: 'Геомагнитные помехи и механический прогиб бурильного инструмента искажают чистые сигналы датчиков, повышая риск ухода ствола из продуктивного пласта.',
  },
]

const ALGORITHMS = [
  {
    title: 'Модуль контроля наработки (Резьба API 7G)',
    sub: 'Автоматический поузловой расчет износа по серийным номерам',
    tag: '// Исключение обрывов КНБК',
    accent: false,
  },
  {
    title: 'Математическая коррекция навигации (Sag + SCC)',
    sub: 'Фильтрация геомагнитных помех и компенсация прогиба колонны',
    tag: '● Точность проводки 100%',
    accent: true,
  },
  {
    title: 'Спектральный анализ забойных вибраций (RMS)',
    sub: 'Разложение динамических нагрузок на три независимые физические компоненты',
    tag: '// Защита электроники MWD',
    accent: false,
  },
]
---

<section id="economics" data-theme="black">
  <div class="econ-head">
    <div class="econ-head-title">
      <span class="econ-kicker mono reveal">// Безопасность и критическая аналитика</span>
      <h2 class="h-title reveal">Экономика бурения</h2>
    </div>
    <div class="econ-head-lead">
      <p class="lead reveal">
        Разрозненность данных и скрытые дефекты оборудования — главные причины аварий.
        Комплексный подход Геотехнавигации (надежное железо + онлайн-аналитика)
        ликвидирует эти риски.
      </p>
    </div>
  </div>

  <div class="econ-problems reveal">
    {PROBLEMS.map((p) => (
      <div class="econ-problem">
        <div class="econ-problem-head">
          <span class="econ-problem-kicker mono">{p.kicker}</span>
          <h3>{p.title}</h3>
        </div>
        <p class="econ-problem-text">{p.text}</p>
      </div>
    ))}
  </div>

  <div class="econ-synergy reveal">
    <div class="econ-synergy-main">
      <div class="econ-synergy-copy">
        <span class="econ-synergy-kicker mono">[ синергия_комплекса ]</span>
        <h3 class="econ-synergy-title">Скважинные приборы под ИТ-контролем</h3>
        <p class="econ-synergy-text">
          Мы объединяем физическую надежность оборудования с мгновенной
          WebSocket-аналитикой. Один диспетчер в технологическом центре способен
          удаленно контролировать до 10 буровых одновременно, снижая затраты
          на персонал на 30–40%.
        </p>
      </div>
      <div class="econ-badge mono">
        <span>Экономия от 10 млн ₽</span>
        <span>● Нагрузка оптимальна</span>
      </div>
    </div>

    <div class="econ-algos">
      <span class="econ-algos-kicker mono">[ промышленные_алгоритмы ]</span>
      <div class="econ-algo-list">
        {ALGORITHMS.map((a) => (
          <div class="econ-algo-row">
            <div class="econ-algo-copy">
              <span class="econ-algo-title">{a.title}</span>
              <span class="econ-algo-sub">{a.sub}</span>
            </div>
            <span class={`econ-algo-tag mono${a.accent ? ' is-accent' : ''}`}>{a.tag}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
