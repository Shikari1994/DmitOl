---
/* «Экономика бурения» — копия 1-в-1 с Dmit (блок «БЕЗОПАСНОСТЬ И
   КРИТИЧЕСКАЯ АНАЛИТИКА»), тем же приёмом, что и Showcase.astro.
   Тексты перенесены дословно, вплоть до опечаток исходника.

   Номер раздела в кикере размечен теми же .ey-no/.ey-den, что и у
   остальных секций, но стили подключены точечно в economics.css, а не
   через общий класс .eyebrow: тот принёс бы свои margin и color и
   разъехался с уже увязанной геометрией .econ-kicker. */

const PROBLEMS = [
  {
    kicker: 'Проблема 01 // фрагментация',
    title: 'Разрозненные системы',
    text: 'Инклинометрия, расчёт прочности бурильной колонны и контроль состояния оборудования часто ведутся в разных системах. Данные приходится сопоставлять вручную, из-за чего теряется целостная картина и увеличивается время принятия решений.',
  },
  {
    kicker: 'Проблема 02 // ручной ввод',
    title: 'Неточный контроль наработки КНБК',
    text: 'Ручной перенос часов циркуляции в журналы повышает риск ошибок и не позволяет точно отслеживать фактическую наработку компонентов КНБК. В результате своевременная замена изношенных узлов откладывается, повышая риск отказов электроники, повреждения резьбовых соединений и потери инструмента.',
  },
  {
    kicker: 'Проблема 03 // инфо-вакуум',
    title: 'Ошибки интерпретации',
    text: 'Геомагнитные помехи и механический прогиб бурильного инструмента влияют на результаты измерений и усложняют их интерпретацию. Без комплексной коррекции этих факторов возрастает риск ошибки в определении положения ствола и ухода из продуктивного интервала.',
  },
]

const ALGORITHMS = [
  {
    title: 'Расчёт BSR и контроль наработки КНБК',
    sub: 'Автоматический расчёт BSR (Bending Strength Ratio) и поузловой учёт наработки элементов КНБК по серийным номерам. Контроль накопленного ресурса помогает своевременно выявлять узлы, требующие диагностики или замены.',
    tag: 'Снижение риска обрывов КНБК',
    accent: false,
  },
  {
    title: 'Пространственная коррекция навигации',
    subTitle: 'Коррекция Sag + SCC',
    sub: 'Алгоритмическая компенсация механического прогиба бурильной колонны (Sag) и учёт влияния естественных геомагнитных помех при обработке навигационных данных.',
    tag: '● Повышение достоверности навигации',
    accent: true,
  },
  {
    title: 'Трёхкомпонентный анализ вибраций',
    subTitle: 'Контроль динамических нагрузок',
    sub: 'Анализ вибраций по осевой, поперечной и крутильной компонентам с расчётом RMS-показателей. Выявление опасных режимов работы для защиты скважинного оборудования и телеметрии.',
    tag: 'Снижение риска повреждения скважинной электроники',
    accent: false,
  },
]
---

<section id="economics" data-theme="black">
  <div class="econ-kicker mono reveal">
    <span class="ey-no">05<span class="ey-den"> / 06</span></span>Безопасность и критическая аналитика
  </div>
  <div class="econ-head glass">
    <div class="econ-head-title">
      <h2 class="h-title reveal">Экономика бурения</h2>
    </div>
    <div class="econ-head-lead">
      <p class="lead reveal">
        Разрозненность данных и скрытые дефекты оборудования — одни из главных причин аварий и внеплановых простоев.
        Комплексный подход «ГеоТехНавигации» — надёжное оборудование в сочетании с онлайн-аналитикой — позволяет своевременно выявлять риски,
        снижать вероятность аварий и повышать эффективность бурения.
      </p>
    </div>
  </div>

  <div class="econ-problems reveal">
    {PROBLEMS.map((p) => (
      <div class="econ-problem">
        <div class="econ-problem-head">
          <span class="econ-problem-kicker mono">{p.kicker}</span>
          <h3>{p.title}</h3>
        </div>
        <div class="econ-problem-text">
          <p class="econ-problem-copy">{p.text}</p>
        </div>
      </div>
    ))}
  </div>

  <div class="econ-synergy reveal">
    <div class="econ-synergy-main">
      <div class="econ-synergy-copy">
        <span class="econ-synergy-kicker mono">синергия_комплекса</span>
        <h3 class="econ-synergy-title">Скважинные приборы под единым цифровым контролем</h3>
        <p class="econ-synergy-text">
          Мы объединяем физическую надежность оборудования с мгновенной
          WebSocket-аналитикой. Один диспетчер в технологическом центре способен
          удаленно контролировать до 10 буровых одновременно, снижая затраты
          на персонал на 30–40%.
        </p>
      </div>
      <div class="econ-badge mono">
        <span>Экономия от 10 млн ₽</span>
        <span>● Нагрузка оптимальна</span>
      </div>
    </div>

    <div class="econ-algos">
      <span class="econ-algos-kicker mono">промышленные_алгоритмы</span>
      <div class="econ-algo-list">
        {ALGORITHMS.map((a) => (
          <div class="econ-algo-row">
            <div class="econ-algo-copy">
              <span class="econ-algo-title">{a.title}</span>
              {a.subTitle && <span class="econ-algo-subtitle">{a.subTitle}</span>}
              <span class="econ-algo-sub">{a.sub}</span>
            </div>
            <span class={`econ-algo-tag mono${a.accent ? ' is-accent' : ''}`}>{a.tag}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
