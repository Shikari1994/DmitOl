---
/* ─── «О компании» — одна сцена, всё движется вместе ───

   Акты не идут друг за другом, а разворачиваются ОДНОВРЕМЕННО по одному
   прогрессу прокрутки:

     • плашки с фактами о компании выезжают из-за правой кромки, одна за другой;
     • снизу выходит и подрастает земной шар, доворачиваясь Россией;
     • заливка сгущается в ночь.

   К финалу шар заполнил кадр, ночь в полную силу, перечень услуг
   прочитан целиком. Слева всегда виден полный блок о компании; заголовок
   над ним — строка про Россию, она же объясняет, зачем в секции глобус,
   и заливается белым по мере прокрутки тем же приёмом, что и ночь.

   Разметка только раскладывает слои. Движение ведёт
   scripts/aboutScene.js, шар — globeCanvas.js; прогресс у них общий,
   поэтому они не разъезжаются. */
const GEO_WORDS = 'Реализуем проекты по всей России'.split(' ')

const FACTS = [
  {
    label: 'ООО «Геотехнавигация»',
    text: 'Российский разработчик и производитель систем скважинной навигации и геофизических исследований в процессе бурения. С 2016 года мы создаём решения, гарантирующие точность проводки ствола и безопасность буровых работ.',
  },
  {
    label: '10 лет компетенций',
    text: 'Полный цикл проектирования, серийного производства и сервисного обслуживания телеметрии MWD/LWD — без зависимости от импортного софта.',
  },
  {
    label: 'Аппаратный базис GT‑Navigator',
    text: 'Выпуск инклинометров, модулей естественного гамма-излучения, резистивиметров и наземных комплексов декодирования.',
  },
  {
    label: 'Цифровой комплекс Drill Monitor',
    text: 'Единая платформа для мгновенного WebSocket-стриминга, математической коррекции траектории (Sag + SCC), автоматического BSR-расчёта прочности резьб и предиктивного анализа аварийных ситуаций.',
  },
]

/* Факты о компании — колонка плашек, а не карусель: у каждого своя плашка, все
   стоят во всю высоту сцены и выезжают из-за правой кромки по одной по
   мере прокрутки. Прокрутка ведёт показ, но ничего не прячет обратно —
   к финалу перечень читается целиком. */
const SERVICES = [
  'Проектирование профилей скважин, включая технический расчёт и работу с рисками пересечения',
  'Анализ процесса строительства наклонно-направленных и горизонтальных скважин в режиме реального времени с выявлением рисков и расхождений с проектной траекторией',
  'Удалённое сопровождение процесса строительства наклонно-направленных и горизонтальных скважин',
  ['Аренда скважинного оборудования разного уровня', [
    'Комплекс с Резистивиметром',
    'Телеметрическая система с гамма модулем',
    'Прибор резистивиметрии',
  ]],
  'Ремонт и техническое обслуживание скважинного оборудования',
]
---

<section id="about" data-theme="black">
  <div class="atlas" data-atlas>
    <div class="atlas-stage" data-atlas-stage>
      {/* Ночь. Отдельным слоем над заливкой и под шаром: прозрачность
          этого слоя наливает скролл покадрово, а не переключает классом. */}
      <div class="atlas-night" aria-hidden="true"></div>
      <canvas class="atlas-canvas" data-globe-canvas aria-hidden="true"></canvas>

      {/* Подписи городов — пустой слой над канвасом, содержимое собирает
          scripts/globe/labels.js по списку CITIES. Разметки здесь нет
          намеренно: без three.js спроецировать города некуда, а список
          имён без шара под ними ничего не значит. */}
      <div class="atlas-pins" data-atlas-pins aria-hidden="true"></div>

      {/* Заголовок стоит на месте всю сцену и к финалу перекрашивается
          в светлый под ночью (.is-night).

          Дублирующий span-оверлей — чисто визуальный слой заливки, он
          aria-hidden: screen reader читает текст один раз, из самого h2.
          Заливка идёт ПО СЛОВАМ, а не сплошной полосой поперёк строки:
          при переносе на вторую строку общий clip-path резал бы обе
          одной вертикальной чертой. Ведёт aboutScene.js тем же
          прогрессом, что доворачивает шар. */}
      <div class="atlas-copy">
        <div class="atlas-head">
          <div class="eyebrow"><span class="ey-no">01<span class="ey-den"> / 06</span></span>О компании</div>
          <h2 class="atlas-geo" data-atlas-geo>
            {GEO_WORDS.join(' ')}
            {/* Копия по словам: заливка идёт по чтению — слово за словом,
                внутри слова буква за буквой (тот же clip-path, но на
                каждом слове свой). Ведёт aboutScene.js. */}
            <span class="atlas-geo-fill" aria-hidden="true">
              {GEO_WORDS.map((w, i) => (
                <>
                  <span class="atlas-geo-word" data-geo-word={i}>{w}</span>
                  {i < GEO_WORDS.length - 1 && ' '}
                </>
              ))}
            </span>
          </h2>
          <div class="atlas-details">
            {/* .glass на самом списке работает только на очень узком
                телефоне (<350px): там колонка собирается в одну стеклянную
                коробку, а плашки внутри теряют свою. Во всех остальных
                раскладках рецепт с списка снят (см. atlas.css). */}
            <ol class="atlas-list glass" aria-label="О компании">
              {FACTS.map((fact, i) => {
                return (
                  <li class="atlas-item glass" data-atlas-item={i}>
                    <span class="ai-no mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                    <span class="ai-text">
                      {fact.label && <strong>{fact.label}</strong>}
                      {fact.text}
                    </span>
                  </li>
                )
              })}
            </ol>
          </div>
        </div>
      </div>

      <div class="atlas-deck">
        {/* Подпись держит левую кромку колонки и стоит НАД ней, вне потока:
            верх правой колонки синхронизирован с первой левой плашкой
            (--deck-top), и подпись в потоке сдвинула бы плашки вниз с
            общей горизонтали. Она же озаглавливает список для screen
            reader — прежний aria-label на div без роли не читался. */}
        <div class="atlas-services" data-atlas-services>
          <span class="atlas-services-kicker mono" id="atlas-services-kicker">Услуги</span>
          {/* .glass — по той же причине, что и у списка фактов выше. */}
          <ol class="atlas-services-list glass" aria-labelledby="atlas-services-kicker">
            {SERVICES.map((s, i) => {
              const [text, bullets] = Array.isArray(s) ? s : [s, null]
            return (
              <li class="atlas-service glass">
                <span class="as-no mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="as-text">
                  {text}
                  {bullets && (
                    <ul class="as-bullets">
                      {bullets.map((b) => <li>{b}</li>)}
                    </ul>
                  )}
                </span>
              </li>
            )
            })}
          </ol>
        </div>
      </div>
    </div>
  </div>
</section>
