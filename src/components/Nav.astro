---
import { Image } from 'astro:assets'
import { asset } from '../lib/asset.js'
import logoWhite from '../assets/brand/logo-white.png'
import logoColor from '../assets/brand/logo-color.webp'
import { ENABLE_LIGHT_THEME } from '../lib/flags.js'

/* Пунктов пять — по числу занятых колонок сетки между направляющими
   --rail-1…--rail-6 (шестая пустая, .nav-tail закреплена явным
   grid-column, чтобы она не утащила хвост влево, см. nav.css). Добавляя
   пункт, пересчитать сетку там же. «Контакты» в строке нет намеренно:
   на них ведёт кнопка «Связаться» справа, полный список — в мобильном
   меню.

   Компонент только рисует разметку, на клиент не едет: .scrolled,
   бургер и .menu-open навешивает scripts/nav.js.

   Хэши идут через asset('/#...'), а не голым '#...': компонент рисуется
   и на страницах товара, где этих секций в DOM нет. С главной это
   переход в пределах документа, со страницы товара — обычный переход на
   главную с якорем; asset() поверх нужен ради BASE_PATH. */
const LINKS = [
  ['/#about', 'О компании'],
  ['/#products', 'Оборудование'],
  ['/#software', 'Drill Monitor'],
  ['/#economics', 'Экономика бурения'],
  ['/#how', 'Технологии'],
]

const MOBILE_LINKS = [...LINKS, ['/#contact', 'Контакты']]
---

<nav class="nav glass">
  <a class="nav-logo" href={asset('/')}>
    {/* В вёрстке лого 23px и 34px по высоте (nav.css), поэтому оба кадра
        режутся до двойного ретина-запаса: исходный PNG белого лого весит
        170 КБ при нужных здесь единицах КБ. */}
    <Image class="nav-logo-img nav-logo-img--dark" src={logoWhite} height={68} format="webp" alt="ГЕОТЕХНАВИГАЦИЯ" loading="eager" />
    {/* Цветное лого — только для светлой схемы (nav.css гасит его через
        display:none в тёмной). С выключенным ENABLE_LIGHT_THEME его нет
        в разметке совсем, а не спрятано: display:none у <img> не мешает
        браузеру скачать кадр, и оно грузилось бы на каждой странице,
        никогда не показавшись. */}
    {ENABLE_LIGHT_THEME && (
      <Image class="nav-logo-img nav-logo-img--light" src={logoColor} height={68} alt="ГЕОТЕХНАВИГАЦИЯ" loading="eager" />
    )}
    <span class="nav-logo-text">Геотехнавигация</span>
  </a>
  <ul class="nav-links">
    {LINKS.map(([href, label]) => (
      <li>
        <a href={asset(href)}>{label}</a>
      </li>
    ))}
  </ul>
  <div class="nav-tail">
    {/* Реальное московское время, не декорация: бригады работают в
        нескольких часовых поясах, общий ориентир в шапке снимает вопрос
        «сколько там сейчас». Тикает scripts/nav.js, здесь состояние до
        него. */}
    <span class="nav-clock mono" id="nav-clock">МОСКВА · --:--:--</span>
    {ENABLE_LIGHT_THEME && (
      <button class="theme-toggle" type="button" aria-label="Переключить тему" aria-pressed="false">
        <svg class="theme-toggle-icon theme-toggle-icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
        </svg>
        <svg class="theme-toggle-icon theme-toggle-icon--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
        </svg>
      </button>
    )}
    <a class="pill nav-cta" href={asset('/#contact')}>
      Связаться
      <span class="btn-corners" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
    </a>
  </div>
  <button
    class="nav-burger"
    aria-label="Открыть меню"
    aria-expanded="false"
    aria-controls="mobile-menu"
  >
    <span></span><span></span><span></span>
  </button>
</nav>

<div id="mobile-menu" class="nav-mobile glass" aria-hidden="true">
  <ul>
    {MOBILE_LINKS.map(([href, label]) => (
      <li><a href={href}>{label}</a></li>
    ))}
  </ul>
  {ENABLE_LIGHT_THEME && (
    <button class="theme-toggle" type="button" aria-label="Переключить тему" aria-pressed="false">
      <svg class="theme-toggle-icon theme-toggle-icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
      </svg>
      <svg class="theme-toggle-icon theme-toggle-icon--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
      </svg>
    </button>
  )}
  <a class="pill pill--solid" href={asset('/#contact')}>Связаться</a>
</div>
