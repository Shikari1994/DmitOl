---
import { asset } from '../lib/asset.js'

/* Пунктов пять — по числу колонок сетки между направляющими
   --rail-1…--rail-6, которые фактически заняты (шестая, последняя,
   остаётся пустой; .nav-tail закреплена явным grid-column, поэтому
   пустая колонка не утаскивает часы/кнопку влево, см. nav.css).
   «Контакты» в строке нет намеренно — на них ведёт кнопка «Связаться»
   справа. Полный список живёт в мобильном меню.

   2026-07-25: добавлен пункт «Экономика бурения» (#economics) между
   Drill Monitor и Технологии — по месту в потоке страницы секция и
   раньше стояла между Mobile и How, теперь это отражено и в шапке.
   Сетка nav.css пересчитана с 4+1 резервных колонок на 5+1 под пятый
   пункт (см. комментарий у .nav-tail).

   Компонент только рисует разметку, на клиент он не едет: класс
   .scrolled, открытие бургера и .menu-open на body навешивает
   scripts/nav.js. Состояние ниже — исходное.

   2026-07-25: хэши ведут через asset('/#...'), не голым '#...' —
   компонент теперь рисуется и на страницах товара (src/pages/products/
   [id].astro), у которых нет ни этих секций в DOM, ни своего домена:
   '/#products' с главной — переход в пределах документа (браузер не
   перегружает страницу, раз путь совпадает с текущим), а со страницы
   товара — обычный переход на главную с якорем. asset() поверх нужен
   ради BASE_PATH (GitHub Pages, см. lib/asset.js) — без него ссылка
   потеряла бы под-путь. Scrollspy (scripts/nav.js и
   scripts/motion/scrollspy.js) подобран под новый формат хэша отдельно. */
const LINKS = [
  ['/#about', 'О компании'],
  ['/#products', 'Оборудование'],
  ['/#software', 'Drill Monitor'],
  ['/#economics', 'Экономика бурения'],
  ['/#how', 'Технологии'],
]

const MOBILE_LINKS = [...LINKS, ['/#contact', 'Контакты']]
---

<nav class="nav">
  <a class="nav-logo" href={asset('/')}>
    <img src={asset('/logo.webp')} alt="ГЕОТЕХНАВИГАЦИЯ" />
    <span class="nav-logo-text">Геотехнавигация</span>
  </a>
  <ul class="nav-links">
    {LINKS.map(([href, label]) => (
      <li>
        <a href={asset(href)}>{label}</a>
      </li>
    ))}
  </ul>
  <div class="nav-tail">
    {/* Реальное московское время, не декорация: компания координирует
        бригады по нескольким часовым поясам, и общий ориентир в шапке —
        тот же приборный регистр, что у readout'ов на экранах Drill
        Monitor. Тикает scripts/nav.js; здесь только состояние до JS. */}
    <span class="nav-clock mono" id="nav-clock">МОСКВА · --:--:--</span>
    <button class="theme-toggle" type="button" aria-label="Переключить тему" aria-pressed="false">
      <svg class="theme-toggle-icon theme-toggle-icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
      </svg>
      <svg class="theme-toggle-icon theme-toggle-icon--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
      </svg>
    </button>
    <a class="pill nav-cta" href={asset('/#contact')}>
      Связаться
      <span class="btn-corners" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
    </a>
  </div>
  <button
    class="nav-burger"
    aria-label="Открыть меню"
    aria-expanded="false"
    aria-controls="mobile-menu"
  >
    <span></span><span></span><span></span>
  </button>
</nav>

<div id="mobile-menu" class="nav-mobile" aria-hidden="true">
  <ul>
    {MOBILE_LINKS.map(([href, label]) => (
      <li><a href={href}>{label}</a></li>
    ))}
  </ul>
  <button class="theme-toggle" type="button" aria-label="Переключить тему" aria-pressed="false">
    <svg class="theme-toggle-icon theme-toggle-icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
    </svg>
    <svg class="theme-toggle-icon theme-toggle-icon--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
    </svg>
  </button>
  <a class="pill pill--solid" href={asset('/#contact')}>Связаться</a>
</div>
