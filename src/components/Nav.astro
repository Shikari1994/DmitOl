---
import { asset } from '../lib/asset.js'

/* Пунктов четыре — по числу колонок сетки между направляющими
   --rail-1…--rail-6, которые фактически заняты (пятая, последняя,
   осталась пустой после удаления секции «Магазин ЗИП» 2026-07-21;
   .nav-tail закреплена явным grid-column, поэтому пустая колонка не
   утаскивает часы/кнопку влево, см. index.css). «Контакты» в строке
   нет намеренно — на них ведёт кнопка «Связаться» справа. Полный
   список живёт в мобильном меню.

   Компонент только рисует разметку, на клиент он не едет: класс
   .scrolled, открытие бургера и .menu-open на body навешивает
   scripts/nav.js. Состояние ниже — исходное. */
const LINKS = [
  ['#about', 'О компании'],
  ['#products', 'Оборудование'],
  ['#software', 'Drill Monitor'],
  ['#how', 'Технологии'],
]

const MOBILE_LINKS = [...LINKS, ['#contact', 'Контакты']]
---

<nav class="nav">
  <a class="nav-logo" href="#hero">
    <img src={asset('/logo.webp')} alt="ГЕОТЕХНАВИГАЦИЯ" />
    <span class="nav-logo-text">Геотехнавигация</span>
  </a>
  <ul class="nav-links">
    {LINKS.map(([href, label]) => (
      <li>
        <a href={href}>{label}</a>
      </li>
    ))}
  </ul>
  <div class="nav-tail">
    {/* Реальное московское время, не декорация: компания координирует
        бригады по нескольким часовым поясам, и общий ориентир в шапке —
        тот же приборный регистр, что у readout'ов на экранах Drill
        Monitor. Тикает scripts/nav.js; здесь только состояние до JS. */}
    <span class="nav-clock mono" id="nav-clock">МОСКВА · --:--:--</span>
    <button class="theme-toggle" type="button" aria-label="Переключить тему" aria-pressed="false">
      <svg class="theme-toggle-icon theme-toggle-icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
      </svg>
      <svg class="theme-toggle-icon theme-toggle-icon--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
      </svg>
    </button>
    <a class="pill nav-cta" href="#contact">
      Связаться
      <span class="btn-corners" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
    </a>
  </div>
  <button
    class="nav-burger"
    aria-label="Открыть меню"
    aria-expanded="false"
    aria-controls="mobile-menu"
  >
    <span></span><span></span><span></span>
  </button>
</nav>

<div id="mobile-menu" class="nav-mobile" aria-hidden="true">
  <ul>
    {MOBILE_LINKS.map(([href, label]) => (
      <li><a href={href}>{label}</a></li>
    ))}
  </ul>
  <button class="theme-toggle" type="button" aria-label="Переключить тему" aria-pressed="false">
    <svg class="theme-toggle-icon theme-toggle-icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
    </svg>
    <svg class="theme-toggle-icon theme-toggle-icon--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
    </svg>
  </button>
  <a class="pill pill--solid" href="#contact">Связаться</a>
</div>
