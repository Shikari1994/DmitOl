---
/* Финальный разворот раздела «О компании»: пока идёт прокрутка, строка
   сверху набирается по словам, а снизу выезжает земной шар и
   доворачивается Россией к зрителю. Сцена прибита sticky внутри
   длинной обёртки — весь эффект считает один прогресс скролла
   (scripts/globeCanvas.js).

   Шар — не фото-модель, а облако точек по маске суши
   (public/planet-mask.jpg) плюс 8 акцентных городов и fresnel-
   атмосфера; все цвета берутся из токенов темы, поэтому светлая и
   тёмная схема красят его нативно, без CSS-фильтра.

   three.js и маска подгружаются динамически и только при подходе
   секции к экрану. Без WebGL и при reduced-motion остаётся статичная
   строка — она читается сама по себе. */
const HEADLINE = 'Реализуем проекты по всей России'

const { index = '04', total = '04' } = Astro.props
const words = HEADLINE.split(' ')
---

<div class="globe" data-globe>
  <div class="globe-stage">
    <canvas class="globe-canvas" data-globe-canvas aria-hidden="true"></canvas>

    <h3 class="globe-headline">
      {words.map((w, i) => (
        <span class="globe-word" data-globe-word={i}>
          {w}{' '}
        </span>
      ))}
    </h3>

    <span class="globe-label mono" aria-hidden="true">География деятельности</span>
    <span class="globe-count mono" aria-hidden="true">
      <b>{index}</b><i>/{total}</i>
    </span>
  </div>
</div>
