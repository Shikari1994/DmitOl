---
import { Image } from 'astro:assets'
import appMobilePark from '../assets/ui/app-mobile-park.webp'
import appMobileDrilling from '../assets/ui/app-mobile-drilling.webp'
import appMobileBha from '../assets/ui/app-mobile-bha.webp'

/* ── МОБИЛЬНЫЙ КЛИЕНТ ──────────────────────────────────────────────
   Три аппарата в ряд, средний выше боковых; на подходе к секции они
   поднимаются снизу с РАЗНОЙ скоростью — в этой разнице весь эффект,
   одним блоком ряд читался бы картинкой, а не сценой.

   Порядок в массиве = порядок в ряду, средний несёт главный экран
   продукта. Ход отдан motion/mobileStage.js (data-depth — место в
   глубине), здесь только покой: он же вид без скрипта.
   ────────────────────────────────────────────────────────────────── */
const PHONES = [
  { src: appMobilePark, label: 'Парк оборудования и ресурс до ТО' },
  { src: appMobileDrilling, label: 'Мониторинг бурения в реальном времени' },
  { src: appMobileBha, label: 'Компоновка КНБК' },
]

const TAGS = ['Android', 'Live-данные']
---

<section id="mobile" data-theme="black">
  <div class="container">
    <div class="eyebrow reveal"><span class="ey-no">04<span class="ey-den"> / 06</span></span>Программный комплекс · мобильная версия</div>
    <div class="mob-head grid">
      <h2 class="h-title reveal">
        Оперативный контроль скважины с помощью Drillmonitor.
      </h2>
      <div class="mob-head-side reveal">
        <p class="lead">
          Ключевые показатели скважины, механика бурения и парк оборудования — прямо на смартфоне.
          Инженер контролирует бурение непосредственно на площадке, офис — из города.
          Все данные синхронизированы с настольной версией системы и доступны в реальном времени.
        </p>
        <div class="tag-row">
          {TAGS.map((t) => <span class="tag">{t}</span>)}
        </div>
      </div>
    </div>
  </div>

  <div class="mob-stage" data-mob-stage>
    {PHONES.map((p, i) => (
      <figure
        class={'mob-phone' + (i === 1 ? ' is-mid' : '')}
        data-mob-phone
        data-depth={i === 1 ? 0 : 1}
      >
        <Image src={p.src} alt={p.label} loading="lazy" draggable="false" />
      </figure>
    ))}
  </div>
</section>
