---
/* Плавающая боковая навигация — быстрый переход по шести разделам.
   Номера 01…06 не выдуманы заново: это те же eyebrow-метки «0X / 06»,
   что стоят в шапках самих секций, а порядок задаёт index.astro.

   Разметку рисует сервер; активный пункт и появление после hero —
   scripts/sideNav.js. Наблюдатель отдельный, не общий с nav.js: там
   свой набор секций (здесь добавлена Mobile, которой в шапке нет). */
const ITEMS = [
  ['#about', '01', 'О компании'],
  ['#products', '02', 'Продукция'],
  ['#software', '03', 'Drill Monitor'],
  ['#mobile', '04', 'Мобильная версия'],
  ['#economics', '05', 'Экономика бурения'],
  ['#how', '06', 'Технологии'],
]
---

<nav class="side-nav" aria-label="Быстрый переход по разделам страницы">
  <ul>
    {ITEMS.map(([href, num, label]) => (
      <li>
        <a href={href} aria-label={`${label} · раздел ${num}`}>
          <span class="side-nav-tick" aria-hidden="true"></span>
          <span class="glass side-nav-tip" aria-hidden="true">
            <span class="side-nav-tip-num mono">{num}</span>{label}
          </span>
        </a>
      </li>
    ))}
  </ul>
</nav>
