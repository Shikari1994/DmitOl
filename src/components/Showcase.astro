---
import { asset } from '../lib/asset.js'
import { PRODUCTS } from '../data/products.js'

/* 2026-07-21: секция «Продукция» переписана 1-в-1 по D:\Projects\Dmit
   (`id="production"`) — пользователь явно попросил буквальную копию
   текста/анимаций/видео, включая ранее отвергнутые corner-marks (см.
   память dmit-sibling-reference). Тексты карточек — дословный перенос,
   не парафраз.
   Кнопка .rig-cube: изначально 3D-флип-куб 1:1 из Dmit, по прямой
   просьбе пользователя заменён на горизонтальную заливку-«загрузку»
   (clip-path слева направо) — сознательное отклонение от буквальной
   копии, см. index.css.
   2026-07-25: «Подробнее» больше не открывает шторку ТТХ поверх этой
   же страницы — ведёт на отдельную страницу товара src/pages/products/
   [id].astro (там же теперь и данные, см. data/products.js; раздел
   «Продукция» — только витрина, полное ТТХ+фото — на странице товара).
   Шторка (specs-drawer) и её JS удалены целиком, не просто отключены.
   «Запчасти» (07) больше не отдельный случай со ссылкой на внешний
   магазин — обычный седьмой элемент PRODUCTS, рендерится тем же .map.
   2026-07-25: номер «02 / 06» возвращён в кикер по просьбе пользователя
   (та же нумерация, что уже держит SideNav для этого пункта потока) —
   разметка та же .ey-no/.ey-den, но здесь, в отличие от Economics,
   кикер и так сидел на общем классе .eyebrow (см. base.css), так что
   отдельных точечных стилей не потребовалось. */
const ACCORDION_IMAGES = PRODUCTS.reduce((acc, p) => {
  if (p.image) acc[p.id] = p
  return acc
}, {})

/* Ни 01 (mwd), ни 02 (decoder) — не в этом наборе: у обоих своя
   раскладка (крупный абсолютный оверлей во всю высоту плашки, обрезан
   по её рамкам, .rig-media--mwd / .rig-media--decoder в equipment.css),
   а не общий .rig-media--right (тот теперь не используется ни одной
   карточкой, оставлен на случай будущей accordion-картинки того же
   старого типа — выезд узкой полосой под текстом). */
const MEDIA_RIGHT = new Set()
---

<section id="products" data-theme="black">
  {/* Фон на весь раздел целиком, включая шапку (2026-07-21, по просьбе —
      отход от буквальной копии Dmit, где видео лежало только под
      карточками): дорожка (та же, что в hero) видна во всю высоту секции,
      .prod-head больше не глушит её собственным фоном. */}
  <div class="prod-media" aria-hidden="true">
    <video
      class="prod-media-video"
      data-lazy-video={asset('/back2.mp4')}
      muted
      loop
      playsinline
      preload="none"
    ></video>
  </div>

  <div class="prod-head">
    <div class="eyebrow reveal prod-head-eyebrow"><span class="ey-no">02<span class="ey-den"> / 06</span></span>Аппаратные комплексы</div>
    <div class="prod-head-row">
      <h2 class="h-title reveal prod-head-title">Продукция</h2>
      <div class="prod-head-lead">
        <p class="lead reveal">
          Собственное серийное производство узлов, датчиков и элементов
          телесистем. Оборудование полностью соответствует строгим
          международным стандартам качества.
        </p>
      </div>
    </div>
  </div>

  <div class="rig-stage">
    <div class="rig-list reveal">
      {/* Кликабельна только сама кнопка — карточка целиком лишь
          подсвечивается на hover/focus-within (см. .rig-row:hover
          в equipment.css), на страницу товара ведёт только клик по кубу.
          У карточек с фото узла (ACCORDION_IMAGES) строка на hover
          раздвигается вниз и там выезжает фото слева. */}
      {PRODUCTS.map((p) => (
        <div class={ACCORDION_IMAGES[p.id] ? 'rig-row rig-row--accordion' : 'rig-row'}>
          <span class="rig-corners" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <span class="rig-num mono" aria-hidden="true">{p.n} /</span>
          <span class="rig-head">
            <span class="rig-title">{p.title}</span>
            <span class="rig-line mono">{p.line}</span>
          </span>
          <span class="rig-text">{p.text}</span>
          <a class="rig-cube" href={asset(`/products/${p.id}`)}>
            <span class="rig-cube-corners" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
            <span class="rig-cube-label">Подробнее</span>
            <span class="rig-cube-fill" aria-hidden="true"><span class="rig-cube-fill-text">Подробнее<span class="rig-cube-caret">_</span></span></span>
          </a>
          {ACCORDION_IMAGES[p.id] && (
            <span class={`rig-media rig-media--accordion rig-media--${p.id}${MEDIA_RIGHT.has(p.id) ? ' rig-media--right' : ''}`} aria-hidden="true">
              <span class="rig-media-inner">
                <img src={asset(ACCORDION_IMAGES[p.id].image)} alt="" loading="lazy" draggable="false"
                  class={ACCORDION_IMAGES[p.id].imageLight ? 'theme-img theme-img--dark' : undefined} />
                {ACCORDION_IMAGES[p.id].imageLight && (
                  <img src={asset(ACCORDION_IMAGES[p.id].imageLight)} alt="" loading="lazy" draggable="false" class="theme-img theme-img--light" />
                )}
              </span>
            </span>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
