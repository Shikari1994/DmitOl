---
import { asset } from '../lib/asset.js'

/* 2026-07-21: секция «Продукция» переписана 1-в-1 по D:\Projects\Dmit
   (`id="production"`) — пользователь явно попросил буквальную копию
   текста/анимаций/видео, включая ранее отвергнутые corner-marks (см.
   память dmit-sibling-reference). Тексты карточек и ТТХ в шторке —
   дословный перенос, не парафраз.
   Кнопка .rig-cube: изначально 3D-флип-куб 1:1 из Dmit, по прямой
   просьбе пользователя заменён на горизонтальную заливку-«загрузку»
   (clip-path слева направо) — сознательное отклонение от буквальной
   копии, см. index.css. */
const PRODUCTS = [
  {
    id: 'mwd', n: '01', title: 'GT-NAVIGATOR', line: 'Телесистема MWD / LWD (комплект)',
    text: 'Локализация системы с гидравлическим каналом связи.',
    specIndex: 'ИРИ // 01',
    specTitle: 'Телесистема MWD/LWD «GT-Navigator»',
    specs: [
      ['Рабочая температура', 'до +150°C (опция +175°C)'],
      ['Канал передачи данных', 'Гидравлический (пульсатор)'],
      ['Тип встроенных датчиков', 'Инклинометр + Гамма-модуль'],
      ['Совместимость платформ', 'Архитектура QDT Tensor'],
      ['Виброустойчивость', 'Высокая (до 30 g)'],
    ],
  },
  {
    id: 'decoder', n: '02', title: 'НАДЗЕМКА', line: 'Наземный комплекс',
    text: 'Аппаратные модули высокоскоростного декодирования со встроенным промышленным монитором и узлом удаленной связи.',
    specIndex: 'ИРИ // 02',
    specTitle: 'Универсальный наземный комплекс',
    specs: [
      ['Рабочая температура', 'от −40°C до +60°C'],
      ['Канал передачи данных', 'Проводной / Удаленный радиоканал'],
      ['Тип встроенных датчиков', 'Пром. монитор + Коммуникатор'],
      ['Совместимость платформ', 'GT-EM / Noralis / Tensor'],
      ['Виброустойчивость', 'Промышленный стандарт'],
    ],
  },
  {
    id: 'inclinometer', n: '03', title: 'ИНКЛИНОМЕТР', line: 'MEMS Датчики',
    text: 'Высокая виброустойчивость, энергоэффективность и мгновенная обработка данных в скважине.',
    specIndex: 'ИРИ // 03',
    specTitle: 'Универсальный модуль инклинометра',
    specs: [
      ['Рабочая температура', 'от −40°C до +60°C стабильно'],
      ['Канал передачи данных', 'Внутренняя шина данных'],
      ['Тип встроенных датчиков', 'MEMS акселерометры + магнитометры'],
      ['Совместимость платформ', 'Любые системы платформы QDT'],
      ['Виброустойчивость', 'Ультимативная (до 50 g)'],
    ],
  },
  {
    id: 'resistivimeter', n: '04', title: 'РЕЗИСТИВИМЕТР', line: 'Модуль удельного сопротивления',
    text: 'Измерение удельного электрического сопротивления пласта в процессе бурения для оперативной геонавигации.',
    specIndex: 'ИРИ // 04',
    specTitle: 'Модуль удельного сопротивления «Резистивиметр»',
    specs: [
      ['Рабочая температура', 'до +150°C (опция +175°C)'],
      ['Канал передачи данных', 'Гидравлический (пульсатор) / шина инструмента'],
      ['Тип встроенных датчиков', 'Резистивиметр (удельное сопротивление пласта)'],
      ['Совместимость платформ', 'Архитектура QDT Tensor'],
      ['Виброустойчивость', 'Высокая (до 30 g)'],
    ],
  },
  {
    id: 'generator', n: '05', title: 'ГЕНЕРАТОР', line: 'Силовой узел телесистемы',
    text: 'Силовой генератор преобразует энергию потока бурового раствора в электропитание для скважинной электроники.',
    specIndex: 'ИРИ // 05',
    specTitle: 'Силовой генератор',
    specs: [
      ['Рабочая температура', 'до +150°C (опция +175°C)'],
      ['Канал передачи данных', 'Автономное электропитание скважинных модулей'],
      ['Тип узла', 'Силовой генератор (турбогенератор)'],
      ['Совместимость платформ', 'Большинство телесистем MWD/LWD'],
      ['Виброустойчивость', 'Высокая (до 30 g)'],
    ],
  },
  {
    id: 'pulsator', n: '06', title: 'ПУЛЬСАТОР', line: 'Узел формирования сигнала',
    text: 'Гидравлический пульсатор формирует и передаёт телеметрический сигнал по буровому раствору.',
    specIndex: 'ИРИ // 06',
    specTitle: 'Гидравлический пульсатор',
    specs: [
      ['Рабочая температура', 'до +150°C (опция +175°C)'],
      ['Канал передачи данных', 'Гидравлический (формирование сигнала в буровом растворе)'],
      ['Тип узла', 'Гидравлический пульсатор'],
      ['Совместимость платформ', 'Большинство телесистем MWD/LWD'],
      ['Виброустойчивость', 'Высокая (до 30 g)'],
    ],
  },
]

/* 07 «Запчасти» ведёт на внешний перечень (oklimashov.fvds.ru), а не
   в шторку ТТХ — для расходников нет технических характеристик,
   только запрос перечня, поэтому это отдельная ссылка, а не запись
   в PRODUCTS/specs-панелях. */
const FLYOUT_IMAGES = {
  mwd: '/Kitbox2.webp',
  decoder: '/dkd.webp',
}

const ACCORDION_IMAGES = {
  resistivimeter: '/Res.webp',
  pulsator: '/pulser.webp',
}

const PARTS = {
  n: '07', title: 'ЗАПЧАСТИ', line: 'Для телесистем любого типа',
  text: 'Сменные узлы, платы и расходные компоненты — совместимость с оборудованием большинства производителей телесистем.',
  cta: 'Запросить перечень',
}
---

<section id="products" data-theme="black">
  {/* Фон на весь раздел целиком, включая шапку (2026-07-21, по просьбе —
      отход от буквальной копии Dmit, где видео лежало только под
      карточками): дорожка (та же, что в hero) видна во всю высоту секции,
      .prod-head больше не глушит её собственным фоном. */}
  <div class="prod-media" aria-hidden="true">
    <video
      class="prod-media-video"
      data-lazy-video={asset('/back2.mp4')}
      muted
      loop
      playsinline
      preload="none"
    ></video>
  </div>

  <div class="prod-head">
    <div class="eyebrow reveal prod-head-eyebrow">Аппаратные комплексы</div>
    <div class="prod-head-row">
      <h2 class="h-title reveal prod-head-title">Продукция</h2>
      <div class="prod-head-lead">
        <p class="lead reveal">
          Собственное серийное производство узлов, датчиков и элементов
          телесистем. Оборудование полностью соответствует строгим
          международным стандартам качества.
        </p>
      </div>
    </div>
  </div>

  <div class="rig-stage">
    <div class="rig-list reveal">
      {/* 2026-07-24: эксперимент с выездом фото узла на карточках
          (см. equipment.css) — сравниваем два приёма, выбор по месту:
          «mwd» (01) и «decoder» (02) — кнопка убрана целиком, фото
          занимает её место и вылетает справа налево, кликабельна вся
          плашка; «resistivimeter» (04) и «pulsator» (06) — аккордеон,
          строка раздвигается вниз и там выезжает фото слева, кнопка
          «Подробнее» остаётся как была. */}
      {PRODUCTS.map((p) => (
        FLYOUT_IMAGES[p.id] ? (
          <button type="button" class="rig-row rig-row--flyout" data-specs-open={p.id}>
            <span class="rig-corners" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
            <span class="rig-num mono" aria-hidden="true">{p.n} /</span>
            <span class="rig-head">
              <span class="rig-title">{p.title}</span>
              <span class="rig-line mono">{p.line}</span>
            </span>
            <span class="rig-text">{p.text}</span>
            <span class={`rig-media rig-media--flyout rig-media--${p.id}`} aria-hidden="true">
              <img src={asset(FLYOUT_IMAGES[p.id])} alt="" loading="lazy" draggable="false" />
            </span>
          </button>
        ) : (
          <div class={ACCORDION_IMAGES[p.id] ? 'rig-row rig-row--accordion' : 'rig-row'}>
            <span class="rig-corners" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
            <span class="rig-num mono" aria-hidden="true">{p.n} /</span>
            <span class="rig-head">
              <span class="rig-title">{p.title}</span>
              <span class="rig-line mono">{p.line}</span>
            </span>
            <span class="rig-text">{p.text}</span>
            <button type="button" class="rig-cube" data-specs-open={p.id}>
              <span class="rig-cube-corners" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
              <span class="rig-cube-label">Подробнее</span>
              <span class="rig-cube-fill" aria-hidden="true"><span class="rig-cube-fill-text">Подробнее<span class="rig-cube-caret">_</span></span></span>
            </button>
            {ACCORDION_IMAGES[p.id] && (
              <span class={`rig-media rig-media--accordion rig-media--${p.id}`} aria-hidden="true">
                <span class="rig-media-inner">
                  <img src={asset(ACCORDION_IMAGES[p.id])} alt="" loading="lazy" draggable="false" />
                </span>
              </span>
            )}
          </div>
        )
      ))}
      <div class="rig-row">
        <span class="rig-corners" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <span class="rig-num mono" aria-hidden="true">{PARTS.n} /</span>
        <span class="rig-head">
          <span class="rig-title">{PARTS.title}</span>
          <span class="rig-line mono">{PARTS.line}</span>
        </span>
        <span class="rig-text">{PARTS.text}</span>
        <a class="rig-cube" href="https://oklimashov.fvds.ru/" target="_blank" rel="noopener noreferrer">
          <span class="rig-cube-corners" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <span class="rig-cube-label">{PARTS.cta} →</span>
          <span class="rig-cube-fill" aria-hidden="true"><span class="rig-cube-fill-text">{PARTS.cta} →<span class="rig-cube-caret">_</span></span></span>
        </a>
      </div>
    </div>
  </div>
</section>

{/* ── Шторка со спецификациями ──
    Одна шторка на всю линейку: панели лежат друг на друге, JS показывает
    нужную классом .is-on. Разметку и данные держит этот компонент —
    specsDrawer.js только переключает видимость и transform. */}
<div class="specs-overlay" data-specs-overlay></div>
<aside class="specs-drawer glass" data-specs-drawer aria-hidden="true">
  <button class="specs-close" data-specs-close type="button" aria-label="Закрыть характеристики">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18" /></svg>
  </button>
  {PRODUCTS.map((p) => (
    <div class="specs-panel" data-specs-panel={p.id}>
      <span class="specs-index mono">{p.specIndex}</span>
      <span class="specs-eyebrow mono">Технические характеристики</span>
      <h3 class="specs-title">{p.specTitle}</h3>
      <dl class="specs-list">
        {p.specs.map(([label, value]) => (
          <div class="specs-row">
            <dt>{label}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>
      <a class="btn btn-primary specs-cta" href="#contact" data-specs-close>
        <span class="btn-corners" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        Запросить ТЭО системы
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
      </a>
    </div>
  ))}
</aside>
