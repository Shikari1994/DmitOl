---
import { asset } from '../lib/asset.js'

/* 2026-07-21: секция «Продукция» переписана 1-в-1 по D:\Projects\Dmit
   (`id="production"`) — пользователь явно попросил буквальную копию
   текста/анимаций/видео, включая ранее отвергнутые corner-marks и
   3D-кнопку-куб (реопен решения из PRODUCT.md → Anti-references,
   см. память dmit-sibling-reference). Тексты карточек и ТТХ в шторке —
   дословный перенос, не парафраз. */
const PRODUCTS = [
  {
    id: 'mwd', n: '01', title: 'GT-Navigator', line: 'Телесистема MWD / LWD',
    text: 'Локализация системы с гидравлическим каналом связи на базе архитектуры QDT Tensor.',
    specIndex: 'ИРИ // 01',
    specTitle: 'Телесистема MWD/LWD «GT-Navigator»',
    specs: [
      ['Рабочая температура', 'до +150°C (опция +175°C)'],
      ['Канал передачи данных', 'Гидравлический (пульсатор)'],
      ['Тип встроенных датчиков', 'Инклинометр + Гамма-модуль'],
      ['Совместимость платформ', 'Архитектура QDT Tensor'],
      ['Виброустойчивость', 'Высокая (до 30 g)'],
    ],
  },
  {
    id: 'decoder', n: '02', title: 'Наземный комплекс', line: 'Универсальные системы',
    text: 'Аппаратные модули высокоскоростного декодирования со встроенным промышленным монитором и узлом удаленной связи.',
    specIndex: 'ИРИ // 02',
    specTitle: 'Универсальный наземный комплекс',
    specs: [
      ['Рабочая температура', 'от −40°C до +60°C'],
      ['Канал передачи данных', 'Проводной / Удаленный радиоканал'],
      ['Тип встроенных датчиков', 'Пром. монитор + Коммуникатор'],
      ['Совместимость платформ', 'GT-EM / Noralis / Tensor'],
      ['Виброустойчивость', 'Промышленный стандарт'],
    ],
  },
  {
    id: 'inclinometer', n: '03', title: 'Модуль инклинометра', line: 'MEMS Датчики',
    text: 'Высокая виброустойчивость, энергоэффективность и мгновенная обработка данных в скважине.',
    specIndex: 'ИРИ // 03',
    specTitle: 'Универсальный модуль инклинометра',
    specs: [
      ['Рабочая температура', 'от −40°C до +60°C стабильно'],
      ['Канал передачи данных', 'Внутренняя шина данных'],
      ['Тип встроенных датчиков', 'MEMS акселерометры + магнитометры'],
      ['Совместимость платформ', 'Любые системы платформы QDT'],
      ['Виброустойчивость', 'Ультимативная (до 50 g)'],
    ],
  },
]
---

<section id="products" data-theme="black">
  {/* Фон на весь раздел, кроме шапки (2026-07-21, по просьбе — отход
      от буквальной копии Dmit, где видео лежало только под карточками):
      .prod-head непрозрачна своим фоном и перекрывает видео над собой,
      ниже неё дорожка (та же, что в hero) видна во всю ширину секции. */}
  <div class="prod-media" aria-hidden="true">
    <video
      class="prod-media-video"
      data-lazy-video={asset('/hero-scan.mp4')}
      muted
      loop
      playsinline
      preload="none"
    ></video>
  </div>

  <div class="prod-head">
    <div class="prod-head-title">
      <div class="eyebrow reveal">// Аппаратные комплексы</div>
      <h2 class="h-title reveal">Продукция</h2>
    </div>
    <div class="prod-head-lead">
      <p class="lead reveal">
        Собственное серийное производство узлов, датчиков и элементов
        телесистем. Оборудование полностью соответствует строгим
        международным стандартам качества.
      </p>
    </div>
  </div>

  <div class="rig-stage">
    <div class="rig-list reveal">
      {PRODUCTS.map((p) => (
        <button class="rig-row" data-specs-open={p.id} type="button">
          <span class="rig-corners" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <span class="rig-num mono" aria-hidden="true">{p.n} /</span>
          <span class="rig-head">
            <span class="rig-title">{p.title}</span>
            <span class="rig-line mono">{p.line}</span>
          </span>
          <span class="rig-text">{p.text}</span>
          <span class="rig-cube" aria-hidden="true">
            <span class="rig-cube-face">Обзор систем →</span>
            <span class="rig-cube-face">Смотреть ТТХ</span>
            <span class="rig-cube-face">Обзор систем</span>
            <span class="rig-cube-face">Смотреть ТТХ</span>
          </span>
        </button>
      ))}
    </div>
  </div>
</section>

{/* ── Шторка со спецификациями ──
    Одна шторка на всю линейку: панели лежат друг на друге, JS показывает
    нужную классом .is-on. Разметку и данные держит этот компонент —
    specsDrawer.js только переключает видимость и transform. */}
<div class="specs-overlay" data-specs-overlay></div>
<aside class="specs-drawer glass" data-specs-drawer aria-hidden="true">
  <button class="specs-close" data-specs-close type="button" aria-label="Закрыть характеристики">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18" /></svg>
  </button>
  {PRODUCTS.map((p) => (
    <div class="specs-panel" data-specs-panel={p.id}>
      <span class="specs-index mono">{p.specIndex}</span>
      <span class="specs-eyebrow mono">// Технические характеристики</span>
      <h3 class="specs-title">{p.specTitle}</h3>
      <dl class="specs-list">
        {p.specs.map(([label, value]) => (
          <div class="specs-row">
            <dt>{label}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>
      <a class="btn btn-primary specs-cta" href="#contact" data-specs-close>
        Запросить ТЭО системы
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
      </a>
    </div>
  ))}
</aside>
