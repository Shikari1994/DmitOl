---
import { asset } from '../lib/asset.js'
import { PRODUCTS } from '../data/products.js'

// На телефоне медиа в карточках не участвует в повествовании. Fallback —
// прозрачный 1×1 px, поэтому оригинальные изображения не запрашиваются.
const DESKTOP_MEDIA_FALLBACK = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw=='

/* Секция «Продукция» — копия 1-в-1 с Dmit (`id="production"`), включая
   corner-marks; тексты карточек перенесены дословно, не парафразом.
   Сознательное отклонение одно: кнопка .rig-cube вместо 3D-флип-куба
   Dmit заливается «загрузкой» слева направо (см. equipment.css).

   Раздел — только витрина: «Подробнее» ведёт на страницу товара
   src/pages/products/[id].astro, где живут полное ТТХ и фото. Данные
   общие, из data/products.js. */
const ACCORDION_IMAGES = PRODUCTS.reduce((acc, p) => {
  if (p.image) acc[p.id] = p
  return acc
}, {})

/* Два типа кадра в разделе:
   — OVERLAY (01, 02) — крупный оверлей во всю высоту плашки справа,
     обрезанный по её рамкам, своя раскладка у каждого;
   — SHOT (03–07) — небольшой кадр слева, на hover выезжает правым краем
     к центру плашки и подрастает. Все пятеро по ОДНОМУ правилу, разница
     только в зуме конкретного файла.
   Оба живут в equipment.css. */
const OVERLAY_MEDIA = new Set(['mwd', 'decoder'])
const isOverlay = (id) => Boolean(ACCORDION_IMAGES[id]) && OVERLAY_MEDIA.has(id)
const isShot = (id) => Boolean(ACCORDION_IMAGES[id]) && !OVERLAY_MEDIA.has(id)
---

<section id="products" data-theme="black">
  {/* Фон на весь раздел, включая шапку — отход от Dmit, где видео лежало
      только под карточками. .prod-head не глушит дорожку своим фоном. */}
  <div class="prod-media" aria-hidden="true">
    <video
      class="prod-media-video"
      data-lazy-video={asset('/video/products-background.mp4')}
      muted
      loop
      playsinline
      preload="none"
    ></video>
  </div>

  <div class="prod-head">
    <div class="eyebrow reveal prod-head-eyebrow"><span class="ey-no">02<span class="ey-den"> / 06</span></span>Аппаратные комплексы</div>
    <div class="prod-head-row glass">
      <h2 class="h-title reveal prod-head-title">Продукция</h2>
      <div class="prod-head-lead">
        <p class="lead reveal">
          Собственное серийное производство узлов, датчиков и элементов
          телесистем. Оборудование полностью соответствует строгим
          международным стандартам качества.
        </p>
      </div>
    </div>
  </div>

  <div class="rig-stage">
    <div class="rig-list reveal">
      {/* Кликабельна ТОЛЬКО кнопка: карточка целиком лишь подсвечивается
          на hover/focus-within, на страницу товара ведёт клик по кубу. */}
      {PRODUCTS.map((p) => (
        <div class={`rig-row glass${ACCORDION_IMAGES[p.id] ? ' rig-row--accordion' : ''}${isShot(p.id) ? ' rig-row--shot' : ''}${isOverlay(p.id) ? ' rig-row--overlay' : ''}`}>
          <span class="rig-corners" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <span class="rig-num mono" aria-hidden="true">{p.n} /</span>
          <span class="rig-head">
            <span class="rig-title">{p.title}</span>
            <span class="rig-line mono">{p.line}</span>
          </span>
          <span class="rig-text">{p.text}</span>
          <a class="rig-cube" href={asset(`/products/${p.id}`)}>
            <span class="rig-cube-corners" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
            <span class="rig-cube-label">Подробнее</span>
            <span class="rig-cube-fill" aria-hidden="true"><span class="rig-cube-fill-text">Подробнее</span></span>
          </a>
          {ACCORDION_IMAGES[p.id] && (
            <span class={`rig-media rig-media--accordion rig-media--${p.id}${isShot(p.id) ? ' rig-media--shot' : ''}`} aria-hidden="true">
              <span class="rig-media-inner">
                <picture class={ACCORDION_IMAGES[p.id].imageLight ? 'theme-img theme-img--dark' : undefined}>
                  <source media="(min-width: 821px)" srcset={ACCORDION_IMAGES[p.id].image.src} />
                  <img src={DESKTOP_MEDIA_FALLBACK} width={ACCORDION_IMAGES[p.id].image.width} height={ACCORDION_IMAGES[p.id].image.height} alt="" loading="lazy" draggable="false" />
                </picture>
                {ACCORDION_IMAGES[p.id].imageLight && (
                  <picture class="theme-img theme-img--light">
                    <source media="(min-width: 821px)" srcset={ACCORDION_IMAGES[p.id].imageLight.src} />
                    <img src={DESKTOP_MEDIA_FALLBACK} width={ACCORDION_IMAGES[p.id].imageLight.width} height={ACCORDION_IMAGES[p.id].imageLight.height} alt="" loading="lazy" draggable="false" />
                  </picture>
                )}
              </span>
            </span>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
