---
import '../styles/index.css'
import logoColor from '../assets/brand/logo-color.webp'
import { ENABLE_LIGHT_THEME } from '../lib/flags.js'

// Лого лежит в src/assets, а не в public: единственный файл на favicon,
// og:image и шапку. Путь у него с хешем содержимого — меняется только
// вместе с самим файлом, поэтому кеш браузера и превью в мессенджерах
// обновляются ровно тогда, когда лого действительно заменили.
const logoHref = logoColor.src

const {
  title = 'ГЕОТЕХНАВИГАЦИЯ — Телеметрия и геонавигация бурения',
  description = 'Разработка и производство телеметрического оборудования MWD/LWD и программного комплекса Drill Monitor для контроля траектории бурения в реальном времени.',
} = Astro.props

const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.pathname

const ogImage = Astro.site ? new URL(logoHref, Astro.site).href : logoHref

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'ГЕОТЕХНАВИГАЦИЯ',
  url: canonical,
  logo: ogImage,
  description,
  areaServed: ['RU', 'СНГ'],
  knowsAbout: ['Телеметрия MWD/LWD', 'Геонавигация бурения', 'Программный комплекс Drill Monitor'],
}
---

<!DOCTYPE html>
<html lang="ru" data-scheme={ENABLE_LIGHT_THEME ? undefined : 'dark'}>
  <head>
    <meta charset="UTF-8" />
    <!-- viewport-fit=cover обязателен: без него env(safe-area-inset-*) на iOS
         всегда ноль, и вся разметка полей под вырез — в --gut, в подвале
         экрана колоды, в футере — не действует. -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/webp" href={logoHref} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="theme-color" content="#141414" id="theme-color-meta" />

    <!-- Схема (светлая/тёмная) ставится синхронно, до отрисовки body:
         иначе на тёмной системе с сохранённым светлым выбором страница
         на первый кадр мелькнула бы дефолтной тёмной, а затем
         перекрасилась бы в светлую после разбора модулей. is:inline —
         не ESM-модуль, выполняется сразу по месту, без defer.

         При выключенном ENABLE_LIGHT_THEME скрипта нет вообще, а
         data-scheme="dark" стоит прямо на <html> (см. выше). Именно
         поэтому выбор схемы нельзя было оставить как есть, просто
         спрятав кнопку: скрипт читает prefers-color-scheme, и посетитель
         со светлой системной темой открыл бы сайт светлым — без
         тумблера, то есть без возможности вернуться. Сохранённый
         localStorage['gtn-theme'] с прошлых визитов по той же причине
         больше не читается и ни на что не влияет. -->
    {ENABLE_LIGHT_THEME && (
      <script is:inline>
        (function () {
          try {
            var KEY = 'gtn-theme'
            var stored = localStorage.getItem(KEY)
            var scheme =
              stored === 'light' || stored === 'dark'
                ? stored
                : window.matchMedia('(prefers-color-scheme: light)').matches
                  ? 'light'
                  : 'dark'
            document.documentElement.setAttribute('data-scheme', scheme)
          } catch (e) {}
        })()
      </script>
    )}

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Перейти к содержимому</a>
    <div class="page-shell">
      <slot />
    </div>
    <!-- Шапка первой и отдельным файлом: бургер начинает нажиматься,
         не дожидаясь разбора Lenis и GSAP из motion.js. -->
    <script>
      import '../scripts/nav.js'
      import '../scripts/sideNav.js'
    </script>
    <!-- Остальное одним тегом, а не тремя: три <script> дали бы три
         бандла и три запроса, хотя модули нужны одновременно. Тяжёлое
         внутри всё равно грузится лениво — three.js подтягивает
         динамический import в globeCanvas.js. -->
    <script>
      import '../scripts/motion.js'
      import '../scripts/heroReadout.js'
      // aboutScene раньше globeCanvas: первый решает, прибивать ли сцену
      // (класс .is-static), второй по этому классу — поднимать ли three.js.
      import '../scripts/aboutScene.js'
      import '../scripts/globeCanvas.js'
      import '../scripts/softwareStage.js'
      import '../scripts/videoLightbox.js'
    </script>
  </body>
</html>
